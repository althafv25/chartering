# ─── Offshore Chartering — frontend environment ────────────────────────
# Values are baked into the build (Vite). Never put secrets here.

# API base URL used by the browser.
#   Development (default): /api/v1  → proxied by Vite to VITE_API_TARGET
#   Production:            https://offshore.example.com/api/v1
VITE_API_URL=/api/v1

# Development proxy target (backend `php artisan serve --port=8001`).
# Can point to a remote backend, e.g. https://staging.example.com
VITE_API_TARGET=http://localhost:8001

# Base URL / path the app is served from
VITE_BASE_URL=/

# Display name
VITE_APP_NAME="Offshore Chartering"

# Fleet map tiles (default: OpenStreetMap; see its tile usage policy, or use your own tile service).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
